{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The single local main window may call only the nine bounded resume-ir application commands.",
  "windows": ["main"],
  "permissions": [
    "allow-get-daemon-lifecycle",
    "allow-retry-daemon",
    "allow-daemon-request",
    "allow-select-import-root",
    "allow-list-managed-roots",
    "allow-import-selected-root",
    "allow-delete-source-root",
    "allow-reveal-source-file",
    "allow-export-diagnostics"
  ]
}
