{
  "schema_version": "resume-ir.windows-ocr-builder-contract.v2",
  "target_triple": "x86_64-pc-windows-msvc",
  "host": {
    "platform": "windows",
    "architecture": "x86_64",
    "native_only": true
  },
  "toolchain": {
    "visual_studio_minimum": "17.13",
    "cmake_minimum": "3.25",
    "ninja_minimum": "1.11",
    "msvc_runtime": "static",
    "lto": true
  },
  "stages": {
    "source_checkout": "exact-clean-commit",
    "compile_output": "compile-output",
    "validated_output": "validated-output",
    "native_smoke_required": true,
    "native_smoke_host": "windows/x86_64",
    "emulated_smoke_acceptable": false
  },
  "network": {
    "source_build_only": true,
    "packaged_runtime_access": "disabled"
  },
  "smoke": {
    "input_format": "ppm-p6-rgb8",
    "input_max_bytes": 33554432,
    "languages": [
      "eng",
      "chi_sim"
    ],
    "output_format": "tesseract-tsv",
    "output_max_bytes": 4194304,
    "timeout_seconds": 30
  }
}
