{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-ir.invalid/schemas/resident-embedding-role-isolation.schema.json",
  "title": "resume-ir resident embedding role-isolation public report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "issue", "source", "revision", "platform", "run", "fixed_workload", "arms", "comparisons", "decision", "privacy", "claims"],
  "properties": {
    "schema_version": { "const": "resume-ir.resident-embedding-role-isolation.v1" },
    "artifact_id": { "const": "resident-embedding-role-isolation-issue-319" },
    "issue": { "const": "#319" },
    "source": { "const": "public_synthetic_daemon_sessions" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "machine", "governor", "memory_measurement"],
      "properties": {
        "os": { "const": "macos" },
        "architecture": { "const": "arm64" },
        "machine": { "const": "M4" },
        "governor": { "const": "H2_Aggressive" },
        "memory_measurement": { "const": "process_tree_private_or_anonymous_peak_mib" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seed", "blocks", "sessions", "sessions_per_arm", "independent_release_daemon_sessions", "williams_balanced", "warmup_seconds", "measurement_seconds", "all_sessions_completed", "thermal_guard_passed", "host_load_guard_passed"],
      "properties": {
        "kind": { "enum": ["smoke", "formal_public_matrix"] },
        "seed": { "const": 20260802 },
        "blocks": { "$ref": "#/$defs/positive_integer" },
        "sessions": { "$ref": "#/$defs/positive_integer" },
        "sessions_per_arm": { "$ref": "#/$defs/positive_integer" },
        "independent_release_daemon_sessions": { "const": true },
        "williams_balanced": { "const": true },
        "warmup_seconds": { "$ref": "#/$defs/positive_number" },
        "measurement_seconds": { "$ref": "#/$defs/positive_number" },
        "all_sessions_completed": { "type": "boolean" },
        "thermal_guard_passed": { "type": "boolean" },
        "host_load_guard_passed": { "type": "boolean" }
      }
    },
    "fixed_workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "upstream_revision", "tokenizer_sha256", "runtime", "quantization", "prepacking", "prefix", "pooling", "input_policy", "max_tokens", "dimension", "bulk_batch", "bulk_tokens_per_input", "bulk_grouping", "bulk_order", "bulk_saturated", "interactive_batch", "interactive_tokens", "interactive_qps", "resident_lifetime", "split_reclaim"],
      "properties": {
        "model_id": { "const": "intfloat-multilingual-e5-small-qint8-r1" },
        "upstream_revision": { "const": "614241f622f53c4eeff9890bdc4f31cfecc418b3" },
        "tokenizer_sha256": { "const": "0b44a9d7b51c3c62626640cda0e2c2f70fdacdc25bbbd68038369d14ebdf4c39" },
        "runtime": { "const": "onnxruntime-1.27" },
        "quantization": { "const": "dynamic_u8s8" },
        "prepacking": { "const": false },
        "prefix": { "const": "passage" },
        "pooling": { "const": "attention_mask_mean_then_l2" },
        "input_policy": { "const": "whole_head_512" },
        "max_tokens": { "const": 512 },
        "dimension": { "const": 384 },
        "bulk_batch": { "const": 4 },
        "bulk_tokens_per_input": { "const": 512 },
        "bulk_grouping": { "const": "fixed_groups_of_four" },
        "bulk_order": { "const": "seeded_frozen" },
        "bulk_saturated": { "const": true },
        "interactive_batch": { "const": 1 },
        "interactive_tokens": { "const": 32 },
        "interactive_qps": { "const": 2 },
        "resident_lifetime": { "const": "daemon_lifetime" },
        "split_reclaim": { "const": "signal_both_before_joining_either" }
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_i3_b4", "split_i3_bulk3_b4", "split_i3_bulk4_b4"],
      "properties": {
        "shared_i3_b4": { "$ref": "#/$defs/arm" },
        "split_i3_bulk3_b4": { "$ref": "#/$defs/arm" },
        "split_i3_bulk4_b4": { "$ref": "#/$defs/arm" }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/comparison" }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "winner", "private_matrix_eligible"],
      "properties": {
        "status": { "enum": ["smoke_pass", "smoke_failed", "won", "lost", "inconclusive"] },
        "winner": { "type": ["string", "null"], "enum": ["split_i3_bulk3_b4", "split_i3_bulk4_b4", null] },
        "private_matrix_eligible": { "type": "boolean" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_private_paths", "contains_filenames", "contains_resume_text", "contains_query_text", "contains_candidate_results", "contains_token_ids", "contains_vectors", "contains_pids", "contains_logs_or_traces", "contains_direct_raw_hashes", "contains_databases_or_indexes", "contains_model_or_runtime_bytes"],
      "properties": {
        "contains_private_paths": { "const": false },
        "contains_filenames": { "const": false },
        "contains_resume_text": { "const": false },
        "contains_query_text": { "const": false },
        "contains_candidate_results": { "const": false },
        "contains_token_ids": { "const": false },
        "contains_vectors": { "const": false },
        "contains_pids": { "const": false },
        "contains_logs_or_traces": { "const": false },
        "contains_direct_raw_hashes": { "const": false },
        "contains_databases_or_indexes": { "const": false },
        "contains_model_or_runtime_bytes": { "const": false }
      }
    },
    "claims": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "positive_integer": { "type": "integer", "minimum": 1 },
    "positive_number": { "type": "number", "exclusiveMinimum": 0 },
    "finite_number": { "type": "number" },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "interactive_threads", "bulk_threads", "resident_count", "sessions", "bulk", "interactive", "resources", "correctness"],
      "properties": {
        "topology": { "enum": ["shared", "split"] },
        "interactive_threads": { "const": 3 },
        "bulk_threads": { "type": "integer", "minimum": 3, "maximum": 4 },
        "resident_count": { "type": "integer", "minimum": 1, "maximum": 2 },
        "sessions": { "$ref": "#/$defs/positive_integer" },
        "bulk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed_batches", "completed_inputs", "mean_throughput_inputs_per_second"],
          "properties": {
            "completed_batches": { "$ref": "#/$defs/count" },
            "completed_inputs": { "$ref": "#/$defs/count" },
            "mean_throughput_inputs_per_second": { "$ref": "#/$defs/positive_number" }
          }
        },
        "interactive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["samples", "successes", "failures", "p50_ms", "p95_ms", "p99_ms", "max_queue_wait_upper_bound_ms"],
          "properties": {
            "samples": { "$ref": "#/$defs/count" },
            "successes": { "$ref": "#/$defs/count" },
            "failures": { "$ref": "#/$defs/count" },
            "p50_ms": { "$ref": "#/$defs/positive_number" },
            "p95_ms": { "$ref": "#/$defs/positive_number" },
            "p99_ms": { "$ref": "#/$defs/positive_number" },
            "max_queue_wait_upper_bound_ms": { "$ref": "#/$defs/positive_number" }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["process_tree_private_or_anonymous_peak_mib"],
          "properties": {
            "process_tree_private_or_anonymous_peak_mib": { "$ref": "#/$defs/positive_number" }
          }
        },
        "correctness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vectors_elementwise_exact", "counts_exact", "order_exact", "cancellation_exact", "timeout_exact", "restart_exact", "ready_exact", "cleanup_exact", "query_results_exact"],
          "properties": {
            "vectors_elementwise_exact": { "type": "boolean" },
            "counts_exact": { "type": "boolean" },
            "order_exact": { "type": "boolean" },
            "cancellation_exact": { "type": "boolean" },
            "timeout_exact": { "type": "boolean" },
            "restart_exact": { "type": "boolean" },
            "ready_exact": { "type": "boolean" },
            "cleanup_exact": { "type": "boolean" },
            "query_results_exact": { "type": "boolean" }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "candidate", "paired_blocks", "bulk_improvement_percent", "bulk_paired_ci95_low_percent", "bulk_paired_ci95_high_percent", "query_p95_regression_percent", "query_p99_regression_percent", "max_queue_wait_upper_bound_ms", "process_tree_private_or_anonymous_peak_mib", "correctness_pass", "gates"],
      "properties": {
        "control": { "const": "shared_i3_b4" },
        "candidate": { "enum": ["split_i3_bulk3_b4", "split_i3_bulk4_b4"] },
        "paired_blocks": { "$ref": "#/$defs/positive_integer" },
        "bulk_improvement_percent": { "$ref": "#/$defs/finite_number" },
        "bulk_paired_ci95_low_percent": { "$ref": "#/$defs/finite_number" },
        "bulk_paired_ci95_high_percent": { "$ref": "#/$defs/finite_number" },
        "query_p95_regression_percent": { "$ref": "#/$defs/finite_number" },
        "query_p99_regression_percent": { "$ref": "#/$defs/finite_number" },
        "max_queue_wait_upper_bound_ms": { "$ref": "#/$defs/positive_number" },
        "process_tree_private_or_anonymous_peak_mib": { "$ref": "#/$defs/positive_number" },
        "correctness_pass": { "type": "boolean" },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bulk_at_least_8_percent", "bulk_ci_positive", "query_p95_within_5_percent", "query_p99_within_10_percent", "queue_wait_within_200_ms", "resource_within_1536_mib", "correctness_exact", "accepted"],
          "properties": {
            "bulk_at_least_8_percent": { "type": "boolean" },
            "bulk_ci_positive": { "type": "boolean" },
            "query_p95_within_5_percent": { "type": "boolean" },
            "query_p99_within_10_percent": { "type": "boolean" },
            "queue_wait_within_200_ms": { "type": "boolean" },
            "resource_within_1536_mib": { "type": "boolean" },
            "correctness_exact": { "type": "boolean" },
            "accepted": { "type": "boolean" }
          }
        }
      }
    }
  }
}
