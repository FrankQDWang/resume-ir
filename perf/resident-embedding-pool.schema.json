      "additionalProperties": false,
      "required": ["contains_private_paths", "contains_filenames", "contains_resume_text", "contains_query_text", "contains_candidate_results", "contains_document_or_version_ids", "contains_token_ids", "contains_vectors", "contains_pids", "contains_logs_or_traces", "contains_direct_raw_hashes", "contains_databases_or_indexes", "contains_model_or_runtime_bytes"],
