      "required": ["control", "candidate", "paired_blocks", "bulk_improvement_percent", "bulk_paired_ci95_low_percent", "bulk_paired_ci95_high_percent", "query_p95_regression_percent", "query_p99_regression_percent", "max_interactive_resident_queue_wait_ms", "max_process_tree_private_or_anonymous_peak_mib", "outcome_guard_pass", "correctness_pass", "gates"],
