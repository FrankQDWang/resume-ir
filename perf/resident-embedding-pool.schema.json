        "query_p95_regression_percent": { "$ref": "#/$defs/number" },
        "query_p99_regression_percent": { "$ref": "#/$defs/number" },
        "max_interactive_resident_queue_wait_ms": { "$ref": "#/$defs/nonnegative_number" },
        "max_process_tree_private_or_anonymous_peak_mib": { "$ref": "#/$defs/positive_number" },
        "outcome_guard_pass": { "type": "boolean" },
        "correctness_pass": { "type": "boolean" },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bulk_at_least_15_percent", "bulk_ci_positive", "query_p95_within_5_percent", "query_p99_within_10_percent", "direct_queue_wait_within_200_ms", "resource_within_1536_mib", "outcomes_exact", "correctness_exact", "accepted"],
          "properties": {
            "bulk_at_least_15_percent": { "type": "boolean" },
            "bulk_ci_positive": { "type": "boolean" },
            "query_p95_within_5_percent": { "type": "boolean" },
            "query_p99_within_10_percent": { "type": "boolean" },
            "direct_queue_wait_within_200_ms": { "type": "boolean" },
            "resource_within_1536_mib": { "type": "boolean" },
            "outcomes_exact": { "type": "boolean" },
            "correctness_exact": { "type": "boolean" },
            "accepted": { "type": "boolean" }
          }
